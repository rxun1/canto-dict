{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Replaces the base exclude list, so it repeats those entries. data-pipeline has its own tsconfig.
  "exclude": ["node_modules", "jest.config.js", "ios", "android", "data-pipeline"]
}
