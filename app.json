{
  "expo": {
    "name": "Canto Dict",
    "slug": "canto-dict",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cantodict",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "com.rxun.cantodict",
      "supportsTablet": false,
      "appleTeamId": "Q7F8RN35TR"
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-asset", "expo-audio", "expo-secure-store", "expo-splash-screen"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
