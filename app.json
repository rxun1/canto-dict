{
  "expo": {
    "name": "Canto Dict",
    "slug": "canto-dict",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cantodict",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "com.rxun.cantodict",
      "supportsTablet": false
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-asset", "expo-audio", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
